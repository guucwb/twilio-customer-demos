# Aché Communication Hub — backend only. Names/placeholders only; keep real values in the root .env.
# Twilio credentials are shared from the root .env (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, EXPECTED_TWILIO_ACCOUNT_SID).

# Master switch for any real outbound send. Default false: the demo never contacts a provider.
ACHE_LIVE_ENABLED=false

# WhatsApp sender, format whatsapp:+E164. Free-form messages require an open 24h customer-service window.
ACHE_WHATSAPP_FROM=
# Destination for "Enviar teste real" (whatsapp:+E164). Never hardcoded in source.
ACHE_DEMO_RECIPIENT_WHATSAPP=

# SMS stays in demo mode unless an SMS-capable sender is deliberately assigned here (+E164).
ACHE_SMS_FROM=
ACHE_DEMO_RECIPIENT_SMS=

# Email via Twilio SendGrid. Both required for LIVE; ACHE_EMAIL_FROM must be a verified sender.
SENDGRID_API_KEY=
ACHE_EMAIL_FROM=
ACHE_DEMO_RECIPIENT_EMAIL=

# Allow the presenter to type a destination instead of the configured recipient. Default false.
ACHE_ALLOW_CUSTOM_RECIPIENT=false
