# Copy to analytics-backend/.env (git-ignored). Server-side only.
PORT=8787
HOST=127.0.0.1
# demo-hmac (local tokens, real HS256 verification) | flex (Twilio IAM token validation)
AUTH_MODE=demo-hmac
DEMO_JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars
# mock | taskrouter (read-only RealTimeStatistics + Workers list)
REALTIME_SOURCE=mock
# mock | insights-mart (JSON data mart file fed by an ETL)
HISTORY_SOURCE=mock
# MART_FILE=analytics-backend/config/mart.local.json
# QUEUE_MAP_FILE=analytics-backend/config/queue-map.local.json
# RBAC_FILE=analytics-backend/config/rbac.local.json
CORS_ORIGINS=http://localhost:3000,https://flex.twilio.com
CACHE_TTL_MS=10000
# Required for REALTIME_SOURCE=taskrouter (prefer an API Key with least privilege):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_SECRET=
# TASKROUTER_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required for AUTH_MODE=flex:
# TWILIO_AUTH_TOKEN=
