# Flash Analytics plugin flags (copy to .env). Never put secrets here: this file is bundled into the browser.
# mock (default) = in-browser simulation with demo profile switcher; api = Architecture B backend
FLEX_APP_ANALYTICS_SOURCE=mock
FLEX_APP_ANALYTICS_API_URL=http://localhost:8787
# Architecture A (UX only): filter the native Real-Time Queues View by allowed Queue SIDs. Requires source=api.
FLEX_APP_ENABLE_QUEUES_FILTER=false
