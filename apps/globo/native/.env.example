# Optional local overrides in apps/globo/.env.local (ignored).
# Twilio and OpenAI credentials are read server-side from the existing root .env.
GLOBO_PUBLIC_URL=https://gustsantos.ngrok.io
GLOBO_AI_ENABLED=true
# Optional model override; otherwise uses the existing OPENAI_MODEL.
GLOBO_OPENAI_MODEL=
# No calls approved by default. Add only explicitly approved test CallSids.
GLOBO_ALLOWED_CALL_SIDS=
# Panel password is generated in .demo-data/panel-password.txt; optional override:
GLOBO_PANEL_PASSWORD=
# Globo default voice: preserve the complete Conversation Relay identifier.
GLOBO_TTS_PROVIDER=ElevenLabs
GLOBO_TTS_LANGUAGE=pt-BR
GLOBO_TTS_VOICE=5p4THmLc2S6kXKO1pOM5-1.06_0.5_0.8
GLOBO_STT_PROVIDER=Google
GLOBO_STT_LANGUAGE=pt-BR
GLOBO_STT_MODEL=telephony
