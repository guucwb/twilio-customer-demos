{
  "name": "@globo/rh-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n globo-api,globo-web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx server/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preflight": "tsx scripts/preflight.ts",
    "tunnel": "node scripts/tunnel.mjs",
    "smoke:ai": "tsx scripts/smoke-ai.ts",
    "verify:tunnel": "tsx scripts/verify-tunnel.ts",
    "test:call": "tsx scripts/test-call.ts",
    "start:native": "node scripts/start-native.mjs",
    "start:gateway": "tsx server/coexist.ts",
    "start:all": "concurrently -k -n globo-gateway,globo-native \"npm run start:gateway\" \"npm run start:native\"",
    "test:native": "vitest run --config native/vitest.config.ts",
    "typecheck:native": "tsc --noEmit -p native/tsconfig.json",
    "build:native": "tsc --noEmit -p native/tsconfig.json && vite build --config native/vite.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "dotenv": "^17.2.3",
    "twilio": "^5.10.3",
    "zod": "^4.1.12",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@types/express": "^5.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12",
    "tsx": "^4.20.6",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
