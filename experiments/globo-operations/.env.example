# Optional local overrides in apps/globo/.env.local (ignored).
# Twilio and OpenAI credentials are read server-side from the existing root .env.
GLOBO_PUBLIC_URL=https://gustsantos.ngrok.io
GLOBO_AI_ENABLED=false
# Optional model override; otherwise uses the existing OPENAI_MODEL.
GLOBO_OPENAI_MODEL=
# No calls approved by default. Add only explicitly approved test CallSids.
GLOBO_ALLOWED_CALL_SIDS=
# Panel password is generated in .demo-data/panel-password.txt; optional override:
GLOBO_PANEL_PASSWORD=
# Globo default voice: preserve the complete Conversation Relay identifier.
GLOBO_TTS_PROVIDER=ElevenLabs
GLOBO_TTS_LANGUAGE=pt-BR
GLOBO_TTS_VOICE=5p4THmLc2S6kXKO1pOM5-1.06_0.5_0.8
GLOBO_STT_PROVIDER=Google
GLOBO_STT_LANGUAGE=pt-BR
GLOBO_STT_MODEL=telephony

# Isolated native lab: do not reuse the baseline port/tunnel without approval.
GLOBO_PORT=3009
# Default off. GA service and approval are server-side only.
GLOBO_INTELLIGENCE_ENABLED=false
GLOBO_INTELLIGENCE_USE_APPROVED=false
GLOBO_INTELLIGENCE_SERVICE_SID=
# Alternative v3 path; mutually exclusive with Classic in this lab.
GLOBO_ORCHESTRATOR_ENABLED=false
GLOBO_ORCHESTRATOR_USE_APPROVED=false
GLOBO_CONVERSATION_CONFIGURATION_ID=

# Existing isolated synthetic profile/schema must be validated separately.
# Native traits persistence is distinct from semantic Recall/auto extraction.
GLOBO_MEMORY_PROVIDER=local
GLOBO_MEMORY_STORE_ID=
GLOBO_MEMORY_PROFILE_ID=
GLOBO_MEMORY_DEDICATED_VALIDATED=false
GLOBO_MEMORY_WRITES_APPROVED=false

# Operational capture must use a dedicated synthetic profile/store. Never HR.
GLOBO_CONVERSATION_ID=
GLOBO_OP_MEMORY_ENABLED=false
GLOBO_OP_MEMORY_USE_APPROVED=false
GLOBO_OP_MEMORY_WRITES_APPROVED=false
GLOBO_OP_MEMORY_STORE_ID=
GLOBO_OP_MEMORY_PROFILE_ID=
# Separate WhatsApp Messaging/voice-note test gates. No sender auto-selection.
GLOBO_WHATSAPP_TEST_APPROVED=false
DEMO_CUSTOMER_WHATSAPP=
GLOBO_DEDICATED_WHATSAPP_SENDER=
GLOBO_AUDIO_TRANSCRIPTION_APPROVED=false
GLOBO_AUDIO_MODEL=

GLOBO_NATIVE_ANALYSIS_APPROVED=false
GLOBO_NATIVE_INTELLIGENCE_CONFIGURATION_ID=
GLOBO_NATIVE_CONVERSATION_IDS=
GLOBO_OPERATOR_IMPACT_ID=
GLOBO_OPERATOR_INTEGRITY_ID=
GLOBO_OPERATOR_FRICTION_ID=

GLOBO_NATIVE_LIVE_CONVERSATION_IDS=

# Additional gate scoped to this operational evolution, independent of old approvals.
GLOBO_OPERATIONS_REMOTE_APPROVED=false
