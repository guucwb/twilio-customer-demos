# Backend only. Keep all actual values in the existing root .env or process environment.
TWILIO_ACCOUNT_SID=
EXPECTED_TWILIO_ACCOUNT_SID=
# Explicit choice: auth-token (default) or api-key. No automatic credential fallback.
TWILIO_AUTH_MODE=
# Only used when TWILIO_AUTH_MODE=api-key; account ownership validated at startup.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Default authentication; stale API Key fields are ignored in auth-token mode.
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
